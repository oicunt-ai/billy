# BILLY local environment overrides.
# Copy to `.env.local` — never commit real secrets.
#
# Development BFF (model catalog). All values below are non-secret
# configuration EXCEPT BILLY_DEV_ACCESS_SECRET — generate a strong random
# value and keep it in `.env.local` only, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Gateway default port is 3000, which collides with `next dev`. Run BILLY
# with `npm run dev:local` (loopback, port 3100) when the Gateway is local.
#
# OICUNT_PLATFORM_GATEWAY_URL=http://127.0.0.1:3000
# BILLY_DEV_JWT_FILE=.dev-auth/token
# BILLY_DEV_AUTH_ENABLED=true
# BILLY_DEV_ACCESS_SECRET=
